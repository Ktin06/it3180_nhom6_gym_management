      "item": [
        {
          "name": "201 – Thêm TIME",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/packages",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{newPackageCode}}\",\n  \"name\": \"Gói kiểm tra Postman\",\n  \"type\": \"TIME\",\n  \"durationDays\": 30,\n  \"price\": 500000\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newPackageCode','F3-'+Date.now()+'-'+Math.floor(Math.random()*10000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Kiểm tra phản hồi', () => { pm.response.to.have.status(201); const r=pm.response.json(); pm.expect(r.status).to.eql('ACTIVE'); pm.expect(r.branchId).to.be.a('number'); pm.expect(r.createdAt).to.be.a('string'); pm.expect(r.updatedAt).to.be.a('string'); pm.expect(pm.response.headers.get('Location')).to.eql('/api/v1/packages/'+r.id); pm.collectionVariables.set('createdPackageCode',r.code); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set('packageId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
