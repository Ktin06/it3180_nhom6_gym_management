    },
    {
      "name": "403 – token Hội viên hoặc Huấn luyện viên",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/packages",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{deniedRoleToken}}",
              "type": "string"
            }
