        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Kiểm tra phản hồi', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().status).to.eql(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Thêm gói – bước 4 (chạy tuần tự)",
      "description": "managerToken: JWT Quản lý có staff ACTIVE. POST TIME/PT tự lưu packageId/emptyBodyPackageId để sửa và ngừng bán trên dữ liệu mới. Chạy tuần tự trên môi trường kiểm thử.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{managerToken}}",
            "type": "string"
          }
        ]
