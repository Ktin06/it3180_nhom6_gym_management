    {
      "name": "Bảng giá công khai – US-F3.1.2 (không cần token)",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "TC-F3.1.2-01a 200 – Khách xem bảng giá",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/public/packages",
            "description": "Không gửi Authorization. Trả gói ACTIVE của chi nhánh mặc định CN01 và gói toàn chuỗi, sắp TIME → SESSION → PT rồi theo giá. Không phân trang."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 và chỉ có trường hiển thị (AC-F3.1.2-01, AC-F3.1.2-03)', () => { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r).to.be.an('array'); const allowed = ['id','name','type','durationDays','sessionCount','price','description']; r.forEach(p => { Object.keys(p).forEach(k => pm.expect(allowed).to.include(k)); pm.expect(p.price).to.be.a('number'); }); });",
                  "pm.test('Sắp TIME → SESSION → PT', () => { const order = { TIME: 0, SESSION: 1, PT: 2 }; const r = pm.response.json(); for (let i = 1; i < r.length; i++) pm.expect(order[r[i - 1].type]).to.be.at.most(order[r[i].type]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "401 – POST vào đường dẫn công khai",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/public/packages",
            "description": "Đường dẫn /api/v1/public/** chỉ mở GET; phương thức khác vẫn cần đăng nhập (S3)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 khi không phải GET', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Danh mục ACTIVE mặc định",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/packages",
        "description": "JWT Quản lý/Lễ tân: chỉ chi nhánh mình và toàn chuỗi. JWT Chủ chuỗi: toàn bộ. Đối chiếu dữ liệu seed để xác minh phạm vi."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Kiểm tra phản hồi', () => { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r.page).to.eql(0); pm.expect(r.size).to.eql(20); pm.expect(r.content).to.be.an('array'); pm.expect(r.totalElements).to.be.a('number'); pm.expect(r.totalPages).to.be.a('number'); r.content.forEach(p => { pm.expect(p.status).to.eql('ACTIVE'); ['id','code','name','type','durationDays','sessionCount','price','description','status','branchId'].forEach(k => pm.expect(p).to.have.property(k)); }); });",
              "if (pm.response.code === 200) { const global = pm.response.json().content.find(p => p.branchId === null); if (global) pm.collectionVariables.set('globalPackageId', global.id); }"
            ]
          }
        }
      ]
    },
