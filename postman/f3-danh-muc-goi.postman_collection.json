    {
      "name": "401 – không có token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/packages",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Kiểm tra phản hồi', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().status).to.eql(401); });"
            ]
