{
  "info": {
    "name": "F3 – Danh mục gói tập (bốn API)",
    "description": "Danh sách, thêm, sửa và ngừng bán. baseUrl gồm /api/v1. Chỉ dùng dữ liệu kiểm thử; nhập token tại máy, không lưu lên Git. Chạy lần lượt danh sách, thêm, sửa, ngừng bán. outsidePackageId phải là gói tồn tại ở chi nhánh khác; globalPackageId là gói toàn chuỗi. POST TIME tự lưu packageId, POST PT tự lưu emptyBodyPackageId để kiểm tra hai cách gọi ngừng bán độc lập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "deniedRoleToken",
      "value": ""
    },
    {
      "key": "managerToken",
      "value": ""
    },
    {
      "key": "createdPackageCode",
      "value": ""
    },
    {
      "key": "packageId",
      "value": ""
    },
    {
      "key": "outsidePackageId",
      "value": ""
    },
    {
      "key": "globalPackageId",
      "value": ""
    },
    {
      "key": "emptyBodyPackageId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Danh mục ACTIVE mặc định",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/packages",
        "description": "JWT Quản lý/Lễ tân: chỉ chi nhánh mình và toàn chuỗi. JWT Chủ chuỗi: toàn bộ. Đối chiếu dữ liệu seed để xác minh phạm vi."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Kiểm tra phản hồi', () => { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r.page).to.eql(0); pm.expect(r.size).to.eql(20); pm.expect(r.content).to.be.an('array'); pm.expect(r.totalElements).to.be.a('number'); pm.expect(r.totalPages).to.be.a('number'); r.content.forEach(p => { pm.expect(p.status).to.eql('ACTIVE'); ['id','code','name','type','durationDays','sessionCount','price','description','status','branchId'].forEach(k => pm.expect(p).to.have.property(k)); }); });",
              "if (pm.response.code === 200) { const global = pm.response.json().content.find(p => p.branchId === null); if (global) pm.collectionVariables.set('globalPackageId', global.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Lọc PT và phân trang",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/packages?type=PT&status=ACTIVE&page=0&size=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Kiểm tra phản hồi', () => { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r.size).to.eql(10); r.content.forEach(p => { pm.expect(p.type).to.eql('PT'); pm.expect(p.status).to.eql('ACTIVE'); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Tra cứu gói ngừng bán",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/packages?status=INACTIVE&page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Kiểm tra phản hồi', () => { pm.response.to.have.status(200); pm.response.json().content.forEach(p => pm.expect(p.status).to.eql('INACTIVE')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "400 – kích thước trang vượt giới hạn",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/packages?size=101"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Kiểm tra phản hồi', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.have.property('size'); });"
