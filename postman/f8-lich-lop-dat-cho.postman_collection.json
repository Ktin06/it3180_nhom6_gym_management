{
  "info": {
    "name": "F8 — Lịch lặp và đặt chỗ lớp nhóm",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Dùng dữ liệu local/staging được phép. Điền ID thật, ngày hiệu lực và access token đúng vai trò; không lưu token vào Git. Sinh buổi là job nội bộ lúc khởi động/mỗi giờ; chọn sessionId đã sinh trước khi đặt. Lịch trùng phòng/HLV bị trả 409. Chỉ dùng gói TIME ACTIVE; không chạy collection lặp trên dữ liệu thật vì các request có ghi dữ liệu."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "managerAccessToken",
      "value": ""
    },
    {
      "key": "memberAccessToken",
      "value": ""
    },
    {
      "key": "classTypeId",
      "value": ""
    },
    {
      "key": "trainerId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "scheduleId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "validFrom",
      "value": ""
    },
    {
      "key": "validTo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Tạo lịch lặp",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classTypeId\": {{classTypeId}}, \"trainerId\": {{trainerId}}, \"roomId\": {{roomId}},\n  \"dayOfWeek\": 2, \"startTime\": \"18:00:00\", \"endTime\": \"19:00:00\", \"capacity\": 10,\n  \"validFrom\": \"{{validFrom}}\", \"validTo\": \"{{validTo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"scheduleId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Danh sách lịch đúng chi nhánh",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules?page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Xem lịch lặp",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules/{{scheduleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sửa lịch — buổi đã sinh giữ nguyên",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules/{{scheduleId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classTypeId\": {{classTypeId}}, \"trainerId\": {{trainerId}}, \"roomId\": {{roomId}},\n  \"dayOfWeek\": 2, \"startTime\": \"18:00:00\", \"endTime\": \"19:00:00\", \"capacity\": 10,\n  \"validFrom\": \"{{validFrom}}\", \"validTo\": \"{{validTo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Đặt lớp hoặc vào chờ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-sessions/{{sessionId}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"memberId\": {{memberId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"bookingId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Xem chỗ đặt và vị trí chờ",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Hủy chỗ và xem hủy muộn/khóa",
      "request": {
        "method": "PUT",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-bookings/{{bookingId}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ngừng lịch — giữ buổi đã sinh",
      "request": {
        "method": "PUT",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules/{{scheduleId}}/deactivate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
