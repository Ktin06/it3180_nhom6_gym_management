{
  "info": {
    "name": "F8 — Lịch lặp và đặt chỗ lớp nhóm",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Dùng dữ liệu local/staging được phép. Điền ID thật, ngày hiệu lực và access token đúng vai trò; không lưu token vào Git. Sinh buổi là job nội bộ lúc khởi động/mỗi giờ; chọn sessionId đã sinh trước khi đặt. Lịch trùng phòng/HLV bị trả 409. Chỉ dùng gói TIME ACTIVE; không chạy collection lặp trên dữ liệu thật vì các request có ghi dữ liệu. Đặt thành công trả BOOKED; lớp đầy trả 409 và thông báo “Lớp đã đủ chỗ”."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "managerAccessToken",
      "value": ""
    },
    {
      "key": "memberAccessToken",
      "value": ""
    },
    {
      "key": "classTypeId",
      "value": ""
    },
    {
      "key": "trainerId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "scheduleId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "validFrom",
      "value": ""
    },
    {
      "key": "validTo",
      "value": ""
    },
    {
      "key": "trainerAccessToken",
      "value": ""
    },
    {
      "key": "newRoomId",
      "value": ""
    },
    {
      "key": "newStartAt",
      "value": ""
    },
    {
      "key": "newEndAt",
      "value": ""
    },
    {
      "key": "attendanceSessionId",
      "value": ""
    },
    {
      "key": "attendanceBookingId",
      "value": ""
    },
    {
      "key": "attendanceUpdatedAt",
      "value": ""
    },
    {
      "key": "sessionToCancelId",
      "value": ""
    },
    {
      "key": "lockedMemberId",
      "value": ""
    },
    {
      "key": "calendarFrom",
      "value": ""
    },
    {
      "key": "calendarTo",
      "value": ""
    },
    {
      "key": "calendarBranchId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Tạo lịch lặp",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classTypeId\": {{classTypeId}}, \"trainerId\": {{trainerId}}, \"roomId\": {{roomId}},\n  \"dayOfWeek\": 2, \"startTime\": \"18:00:00\", \"endTime\": \"19:00:00\", \"capacity\": 10,\n  \"validFrom\": \"{{validFrom}}\", \"validTo\": \"{{validTo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"scheduleId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Danh sách lịch đúng chi nhánh",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules?page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Xem lịch lặp",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules/{{scheduleId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sửa lịch — buổi đã sinh giữ nguyên",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules/{{scheduleId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classTypeId\": {{classTypeId}}, \"trainerId\": {{trainerId}}, \"roomId\": {{roomId}},\n  \"dayOfWeek\": 2, \"startTime\": \"18:00:00\", \"endTime\": \"19:00:00\", \"capacity\": 10,\n  \"validFrom\": \"{{validFrom}}\", \"validTo\": \"{{validTo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Đặt chỗ lớp còn suất",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-sessions/{{sessionId}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\"memberId\": {{memberId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Chỗ được ghi BOOKED\", () => pm.expect(pm.response.json().status).to.eql(\"BOOKED\"));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"bookingId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Xem chỗ đặt và hạn khóa",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Hủy chỗ và xem hủy muộn/khóa",
      "request": {
        "method": "PUT",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-bookings/{{bookingId}}/cancel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Chỗ đã hủy\", () => pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ngừng lịch — giữ buổi đã sinh",
      "request": {
        "method": "PUT",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/class-schedules/{{scheduleId}}/deactivate"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Đổi buổi, điểm danh và gỡ khóa",
      "description": "Dùng ba buổi thử riêng. Buổi đổi giờ/phòng và buổi hủy phải chưa bắt đầu. Buổi điểm danh phải đã bắt đầu và trong ngày Việt Nam, với JWT của huấn luyện viên được phân công. Chạy GET điểm danh trước PUT để nạp bookingId và updatedAt.",
      "item": [
        {
          "name": "Đổi giờ buổi tương lai",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/class-sessions/{{sessionId}}/time",
            "body": {
              "mode": "raw",
              "raw": "{\"startAt\":\"{{newStartAt}}\",\"endAt\":\"{{newEndAt}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Đổi phòng buổi tương lai",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/class-sessions/{{sessionId}}/room",
            "body": {
              "mode": "raw",
              "raw": "{\"roomId\":{{newRoomId}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hủy buổi riêng và trả chỗ",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/class-sessions/{{sessionToCancelId}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem danh sách điểm danh",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainerAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/class-sessions/{{attendanceSessionId}}/attendance"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const row = pm.response.json().bookings.find(row => row.status === \"BOOKED\");",
                  "if (row) {",
                  "  pm.collectionVariables.set(\"attendanceBookingId\", String(row.bookingId));",
                  "  pm.collectionVariables.set(\"attendanceUpdatedAt\", row.updatedAt);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Điểm danh có mặt",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainerAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/class-sessions/{{attendanceSessionId}}/attendance",
            "body": {
              "mode": "raw",
              "raw": "{\"bookingId\":{{attendanceBookingId}},\"status\":\"ATTENDED\",\"expectedUpdatedAt\":\"{{attendanceUpdatedAt}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gỡ khóa đặt lớp",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/members/{{lockedMemberId}}/class-booking-lock"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lịch công khai, hội viên và huấn luyện viên",
      "item": [
        {
          "name": "Lấy chi nhánh để lọc lịch",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/public/class-branches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem lịch lớp công khai",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/public/class-sessions?from={{calendarFrom}}&to={{calendarTo}}&branchId={{calendarBranchId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem lịch và chỗ đặt của tôi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/members/me/class-sessions?from={{calendarFrom}}&to={{calendarTo}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem lịch dạy của tôi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{trainerAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/trainers/me/class-sessions?from={{calendarFrom}}&to={{calendarTo}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Điền ngày yyyy-MM-dd theo giờ Việt Nam. Chọn calendarBranchId từ danh sách chi nhánh. Lịch hội viên và lịch dạy lấy danh tính từ token."
    }
  ]
}
