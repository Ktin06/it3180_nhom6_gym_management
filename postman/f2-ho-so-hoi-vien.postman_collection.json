        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Hội viên đã sửa\",\n  \"phone\": \"{{memberPhone}}\",\n  \"gender\": null,\n  \"dob\": null,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
