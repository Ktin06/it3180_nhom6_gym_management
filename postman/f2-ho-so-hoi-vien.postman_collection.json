  "item": [
    {
      "name": "S2-06 – Ảnh đại diện (US-F2.4.2, #183)",
      "description": "Chọn environment local. Đăng nhập qua F1 và lưu accessToken của lễ tân CN01; lưu token riêng memberAccessToken (member1@example.com), otherMemberAccessToken (member2@example.com), trainerAccessToken và otherBranchAccessToken khi thử quyền. Không lưu token hoặc mật khẩu thật vào collection. Chạy bước tìm HV999001 để lấy memberId đúng database. Chọn file trên máy ở mỗi PUT; không tự đặt Content-Type. Chạy từng request theo mô tả, không chạy cả collection cũ để tránh đổi trạng thái hồ sơ.",
      "item": [
        {
          "name": "Chuẩn bị – Tìm HV999001 và lưu memberId",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/members?keyword=HV999001",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Dữ liệu seed local: HV999001 thuộc member1@example.com. Có thể đổi keyword sang hồ sơ muốn thử."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tìm được đúng một hồ sơ\", () => { const rows = pm.response.json().content; pm.expect(rows).to.have.lengthOf(1); pm.environment.set(\"memberId\", rows[0].id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-F2.4.2-01a – Tải hoặc thay ảnh JPEG/PNG",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/members/{{memberId}}/avatar",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Chọn ảnh hợp lệ ≤ 5 MiB, mỗi cạnh ≤ 8000 px. Chạy lại với ảnh khác để kiểm tra AC-F2.4.2-02.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body rỗng\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-F2.4.2-04a – Xem ảnh đã thu nhỏ",
