{
  "info": {
    "name": "F2 – Hồ sơ hội viên (WBS 1.7.1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bộ request chỉ F2. Cấp accessToken qua environment riêng từ F1 đã triển khai; không có request đăng nhập hay mật khẩu trong collection này. Luồng nhân viên cần tích hợp MemberBranchAccess; email/đồng bộ trạng thái cần MemberAccountAccess. Chạy tạo rồi tìm/sửa, đổi memberPhone khi chạy lại. Các request phân quyền cuối cần token của MEMBER, TRAINER và nhân viên khác chi nhánh."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "memberPhone",
      "value": "0912345678"
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "memberCode",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "memberAccessToken",
      "value": ""
    },
    {
      "key": "trainerAccessToken",
      "value": ""
    },
    {
      "key": "otherBranchAccessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "F2 – Tạo hồ sơ tại quầy",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Hội viên kiểm thử\",\n  \"phone\": \"{{memberPhone}}\",\n  \"gender\": \"MALE\",\n  \"dob\": \"2000-05-20\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"memberId\", String(pm.response.json().id));",
              "pm.collectionVariables.set(\"memberCode\", pm.response.json().memberCode);",
              "pm.test(\"Điện thoại chuẩn đầu 0\", () => pm.expect(pm.response.json().phone).to.match(/^0[0-9]{9}$/));"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Trùng điện thoại bị từ chối",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Hồ sơ trùng\",\n  \"phone\": \"{{memberPhone}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Điện thoại sai định dạng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Hồ sơ sai\",\n  \"phone\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Danh sách và phân trang",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members?page=0&size=20",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Tìm đúng mã",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members?keyword={{memberCode}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Tìm đúng điện thoại",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members?keyword={{memberPhone}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Tìm mã không phân biệt hoa thường",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/members?keyword={{memberCodeLower}}",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.variables.set(\"memberCodeLower\", pm.variables.get(\"memberCode\").toLowerCase());"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Tìm đúng mã dù nhập chữ thường\", () => { const page = pm.response.json(); pm.expect(page.totalElements).to.eql(1); pm.expect(page.content[0].memberCode).to.eql(pm.variables.get(\"memberCode\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Tìm theo tiền tố điện thoại",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/members?keyword={{phonePrefix}}&page=0&size=20",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.variables.set(\"phonePrefix\", pm.variables.get(\"memberPhone\").slice(0, 4));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Kết quả khớp tiền tố điện thoại\", () => { const page = pm.response.json(); pm.expect(page.totalElements).to.be.above(0); page.content.forEach(member => pm.expect(member.phone.startsWith(pm.variables.get(\"phonePrefix\"))).to.eql(true)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Từ chối ngày sinh tương lai",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/members",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Hồ sơ sai ngày sinh\",\n  \"phone\": \"{{memberPhone}}\",\n  \"dob\": \"2999-01-01\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Có lỗi trường ngày sinh\", () => pm.expect(pm.response.json().errors.dob).to.eql(\"Ngày sinh phải ở trong quá khứ\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Tiền tố tên và trạng thái",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members?keyword=H%E1%BB%99i&status=ACTIVE&page=0&size=20",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "F2 – Xem chi tiết",
      "request": {
