        {
          "name": "TC-F5.2.1-01a 200 – Thu tiền chuyển khoản, gói ACTIVE từ hôm nay",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/invoices/{{payInvoiceId}}/payments",
            "description": "Số tiền lấy từ invoices.total, client không gửi. Gói ACTIVE, end_date = hôm nay + số ngày - 1.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"method\": \"BANK_TRANSFER\", \"transactionRef\": \"FT263078912345\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, hóa đơn PAID, gói ACTIVE', () => { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r.status).to.eql('PAID'); pm.expect(r.method).to.eql('BANK_TRANSFER'); pm.expect(r.amount).to.be.at.least(0); pm.expect(r.paymentId).to.be.a('number'); pm.expect(r.activatedMemberships[0].status).to.eql('ACTIVE'); });"
                ]
              }
            }
          ]
        },
