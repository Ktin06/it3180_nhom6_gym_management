            "description": "Xuất file PDF hóa đơn đã thanh toán hoặc đã hoàn tiền (Content-Type: application/pdf, tên file hoa-don-{code}.pdf). Hội viên dùng token của mình cũng tải được hóa đơn của chính mình.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, application/pdf', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); pm.expect(pm.response.headers.get('Content-Disposition')).to.include('hoa-don-'); });"
                ]
              }
