{
  "info": {
    "name": "F5 – Hóa đơn, thu tiền tại quầy, VietQR và PDF (S2-09)",
    "description": "API của thẻ S2-09.1 (UC-F5.2, UC-F5.3 luồng A1). baseUrl gồm /api/v1. Chạy tuần tự từng thư mục. Nhập token tại máy, không lưu lên Git. saleMemberId và cancelMemberId là hai hội viên CN01 chưa có gói cùng loại với salePackageId (dữ liệu mẫu: HV999010 và một hội viên khác chưa có gói); salePackageId là gói TIME đang bán ở CN01. Phạm vi S2-09: sáu endpoint hóa đơn; hoàn tiền thuộc S2-38. Hai thư mục thu tiền/hủy chạy tuần tự. Thư mục kiểm tra số tiền dùng amountMemberId và freeMemberId riêng (chưa có gói chờ cùng loại); freePackageId phải có giá 0. Các token để trống trong file, nhập tại máy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Thu tiền – US-F5.2.1 (chạy tuần tự)",
      "item": [
        {
          "name": "Bước 1 – Bán gói (tạo hóa đơn PENDING để thu tiền)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/invoices",
            "description": "Hội viên saleMemberId chưa có gói cùng loại. Lưu invoiceId vào payInvoiceId.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": {{saleMemberId}},\n  \"items\": [{ \"itemType\": \"PACKAGE\", \"packageId\": {{salePackageId}} }]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('payInvoiceId', pm.response.json().invoiceId);"
                ]
              }
            }
          ]
        },
        {
          "name": "US-F5.2.1 E1 400 – method sai",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/invoices/{{payInvoiceId}}/payments",
            "description": "method chỉ nhận CASH hoặc BANK_TRANSFER.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"method\": \"MOMO\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400, lỗi trường method', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errors).to.have.property('method'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "US-F5.2.1 E3 403 – token Hội viên hoặc Huấn luyện viên",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/invoices/{{payInvoiceId}}/payments",
