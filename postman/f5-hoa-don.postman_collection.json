    {
      "name": "Tra cứu hóa đơn – US-F5.3.1 (S2-09.3)",
      "item": [
        {
          "name": "US-F5.3.1 KB 200 – Danh sách hóa đơn chi nhánh (mới nhất trước)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/invoices?page=0&size=20",
            "description": "Lễ tân hoặc quản lý chỉ thấy hóa đơn chi nhánh mình, sắp xếp createdAt DESC. Hóa đơn khách lẻ (member_id rỗng) vẫn hiện nhờ LEFT JOIN members.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, PageResponse', () => { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r.content).to.be.an('array'); pm.expect(r.page).to.eql(0); pm.expect(r.size).to.eql(20); if (r.content.length > 0 && !pm.collectionVariables.get('payInvoiceId')) { pm.collectionVariables.set('payInvoiceId', r.content[0].id); } });"
                ]
              }
            }
          ]
        },
        {
          "name": "US-F5.3.1 KB 200 – Lọc theo status, source, fromDate, toDate, keyword",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/invoices?status=PENDING&source=COUNTER&fromDate=2026-11-01&toDate=2026-11-30&keyword=HD",
            "description": "fromDate/toDate tính theo ngày Việt Nam nửa mở [from 00:00 VN, to+1 00:00 VN). keyword khớp mã hóa đơn, tên hoặc số điện thoại hội viên.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
