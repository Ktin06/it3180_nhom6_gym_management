            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, có qrImageUrl và transferContent', () => { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r.qrImageUrl).to.include('https://img.vietqr.io/image/'); pm.expect(r.transferContent).to.include(r.invoiceCode); });"
                ]
              }
