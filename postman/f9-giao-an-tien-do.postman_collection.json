              "mode": "raw",
              "raw": "{\n  \"loggedAt\": \"2026-11-21\",\n  \"exercise\": \"Squat\",\n  \"sets\": 4,\n  \"reps\": 10,\n  \"weight\": 60.5,\n  \"ptSessionId\": {{ptSessionId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-F9.5.1-04a 400 – Ngày tập sau hôm nay",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/pt/members/{{studentId}}/workout-logs",
            "description": "Ngày tính theo giờ Việt Nam.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{trainer1Token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loggedAt\": \"2099-01-01\",\n  \"exercise\": \"Squat\",\n  \"sets\": 4,\n  \"reps\": 10,\n  \"weight\": 60.5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-F9.6.1-02a 200 – PT xem tiến độ học viên",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/members/{{studentId}}/progress?from=2026-11-01&to=2026-11-30",
            "description": "Dữ liệu thô: bodyMetrics, workoutLogs sắp ngày tăng dần; không có gợi ý (BR-F9.13).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{trainer1Token}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('có hai danh sách', () => { pm.expect(b.bodyMetrics).to.be.an('array'); pm.expect(b.workoutLogs).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-F9.6.1-01a 200 – Hội viên xem tiến độ của mình",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me/progress",
            "description": "Hội viên lấy từ token; bỏ trống from, to thì 90 ngày đến hôm nay.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
