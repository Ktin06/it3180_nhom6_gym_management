        {
          "name": "US-F4.1.1 KB 200 – Tra cứu theo mã HV999004",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/checkins/search-member?keyword=HV999004",
            "description": "Hồ sơ, mọi gói ở mọi trạng thái, hasAvatar, isCurrentlyCheckedIn. Lưu memberId.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('có gói', () => { const j = pm.response.json(); pm.expect(j.memberCode).to.eql('HV999004'); pm.expect(j.memberships).to.be.an('array').that.is.not.empty; pm.collectionVariables.set('timeSessionMemberId', j.memberId); });"
