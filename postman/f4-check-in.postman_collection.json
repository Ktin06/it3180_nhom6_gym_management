                  "pm.test('PageResponse', () => { const j = pm.response.json(); pm.expect(j.content).to.be.an('array'); if (j.content.length > 0) { pm.expect(j.content[0]).to.have.property('hasAvatar'); pm.expect(j.content[0]).to.not.have.property('avatarUrl'); } });"
