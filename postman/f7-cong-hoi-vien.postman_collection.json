{
  "info": {
    "name": "F7 – Cổng hội viên: yêu cầu mua, gia hạn gói",
    "description": "API của thẻ S2-14.1 (UC-F7.4, UC-F7.5). baseUrl gồm /api/v1. Chạy tuần tự từng thư mục. Nhập token tại máy, không lưu lên Git. memberToken: hội viên CN01 có tài khoản; portalPackageId: gói đang bán ở CN01 mà hội viên chưa có gói cùng loại chờ. Hóa đơn tạo ra tự hủy sau PENDING_INVOICE_TTL_DAYS (tác vụ chạy mỗi giờ); muốn chạy lại thì hủy hóa đơn ở quầy (PUT /invoices/{id}/cancel).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Mua gói – US-F7.4.1 (chạy tuần tự)",
      "item": [
        {
          "name": "US-F7.4.1 KB 201 – Gửi yêu cầu mua",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/me/purchase-requests",
            "description": "Hội viên lấy từ token. Trả mã hóa đơn, tổng tiền và hạn tự hủy expiresAt = created_at + PENDING_INVOICE_TTL_DAYS.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"packageId\": {{portalPackageId}} }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('có invoiceCode, expiresAt', () => { const b = pm.response.json(); pm.expect(b.invoiceCode).to.match(/^HD\\d{6}$/); pm.expect(b.expiresAt).to.be.a('string'); pm.expect(b.status).to.eql('PENDING'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "US-F7.4.1 E4 409 – Gửi lại đúng gói đó",
          "name": "US-F7.4.1 E4 422 – Gửi lại đúng gói đó",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/me/purchase-requests",
            "description": "Đã có hóa đơn chờ cho gói này (bước trước).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"packageId\": {{portalPackageId}} }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "pm.test('thông báo WAITING_EXISTS', () => pm.expect(pm.response.json().detail).to.eql('Hội viên đã có gói cùng loại đang chờ thanh toán hoặc chờ kích hoạt. Không thể tạo thêm gói mới.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "US-F7.4.1 E1 400 – Thiếu packageId",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/me/purchase-requests",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
