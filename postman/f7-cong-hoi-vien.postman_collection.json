              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('lỗi trường packageId', () => pm.expect(pm.response.json().errors).to.have.property('packageId'));"
                ]
              }
            }
          ]
        },
