# Sao chép thành .env rồi sửa giá trị:  cp .env.example .env
# File .env đã nằm trong .gitignore — KHÔNG commit, KHÔNG dán nội dung vào prompt AI.
# Dùng chung cho docker-compose.yml, backend (profile local) và frontend (Vite).

# ===== Cơ sở dữ liệu PostgreSQL =====
DB_HOST=localhost
# Đổi thành 5433 nếu máy đã có PostgreSQL khác chiếm cổng 5432.
DB_PORT=5432
DB_NAME=gym_management
DB_USERNAME=gym
DB_PASSWORD=gym_local_password

# Mật khẩu mẫu cho dữ liệu seed
# Tạo bcrypt hash bằng lệnh Docker trong backend/src/main/resources/db/seed/README.md (quy tắc 3).
# Thay giá trị bên dưới bằng bcrypt hash hợp lệ, không đặt trong dấu nháy.
SEED_PASSWORD_HASH=$2a$12$REPLACE_WITH_VALID_BCRYPT_HASH

# ===== Bảo mật =====
# GIÁ TRỊ GIẢ — PHẢI ĐỔI: chuỗi ngẫu nhiên tối thiểu 32 ký tự, ví dụ tạo bằng: openssl rand -base64 48
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Origin của frontend được gọi thẳng backend (WebSocket F10), phân tách bằng dấu phẩy.
# API thường đi qua proxy cùng domain nên không cần CORS (ADR 0008).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Frontend =====
# Mặc định frontend gọi /api/v1 cùng domain: Vite chuyển tiếp sang localhost:8080 khi chạy dev,
# Vercel chuyển tiếp sang Render khi deploy (ADR 0008). Chỉ bỏ dấu # khi cần gọi thẳng backend khác.
# VITE_API_URL=/api/v1
