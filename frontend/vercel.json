{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://it3180-nhom6-gym-management.onrender.com"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
